<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Agentic.Chat.Components.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Agentic.Chat.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@* Rendered into the chat header rather than floating over the page: a
   fixed bottom-left pill sat on top of the composer and the conversation
   drawer on phone-sized viewports. *@
<SectionContent SectionName="chat-header-actions">
    <CredentialSettings />
</SectionContent>
