@inject OpenRouterCredentialService Credentials
@inject NavigationManager Navigation

<div class="credential-control">
    <button type="button" class="credential-trigger" aria-haspopup="dialog"
            aria-expanded="@_open" title="@(_hasUserKey ? "Personal key" : "Shared free key")"
            @onclick="Toggle" @ref="_trigger">
        <span class="credential-dot @(_hasUserKey ? "personal" : "free")"></span>
        @(_hasUserKey ? "Personal key" : "Shared free")
    </button>

    @if (_open)
    {
        <section class="credential-panel" role="dialog" aria-modal="true"
                 aria-label="OpenRouter API key settings" @onkeydown="HandleKeyDownAsync">
            <div class="credential-panel-header">
                <div>
                    <strong>OpenRouter access</strong>
                    <p>@(_hasUserKey
                        ? "Your key is active. Free and paid models are available."
                        : "The app key can only use free model variants.")</p>
                </div>
                <button type="button" class="credential-close" aria-label="Close"
                        @onclick="Toggle" @ref="_closeButton">×</button>
            </div>

            @if (!_hasUserKey)
            {
                @if (!Credentials.HasSharedFreeKey)
                {
                    <p class="credential-warning" role="status">
                        @(Credentials.SharedConfigurationError
                            ?? "The shared free key is not configured for this deployment.")
                    </p>
                }
                <label for="openrouter-key">Use your own API key</label>
                <input id="openrouter-key" type="password" autocomplete="off" spellcheck="false"
                       placeholder="sk-or-…" @bind="_draftKey" @bind:event="oninput" />
                <label class="credential-remember">
                    <input type="checkbox" @bind="_remember" />
                    Remember on this device
                </label>
                <p class="credential-help">
                    Otherwise the key is removed when this browser session ends.
                    It is sent directly to OpenRouter and never stored with conversations.
                </p>
                @if (_error is not null)
                {
                    <p class="credential-error" role="alert">@_error</p>
                }
                <button type="button" class="credential-primary"
                        disabled="@(_saving || string.IsNullOrWhiteSpace(_draftKey))"
                        @onclick="SaveAsync">
                    @(_saving ? "Checking…" : "Use this key")
                </button>
            }
            else
            {
                <p class="credential-help">
                    Removing your key returns the model picker to shared free models.
                </p>
                @if (_error is not null)
                {
                    <p class="credential-error" role="alert">@_error</p>
                }
                <button type="button" class="credential-secondary"
                        disabled="@_saving" @onclick="RemoveAsync">
                    Remove personal key
                </button>
            }
        </section>
    }
</div>

@code {
    private bool _open;
    private bool _saving;
    private bool _remember;
    private bool _hasUserKey;
    private string _draftKey = string.Empty;
    private string? _error;
    private ElementReference _trigger;
    private ElementReference _closeButton;
    private bool _focusPanelOnRender;
    private bool _restoreTriggerOnRender;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Credentials.InitializeAsync();
        }
        catch (Exception ex)
        {
            _error = $"OpenRouter settings could not be loaded: {ex.Message}";
        }
        _hasUserKey = Credentials.HasUserKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPanelOnRender)
        {
            _focusPanelOnRender = false;
            await _closeButton.FocusAsync();
        }
        else if (_restoreTriggerOnRender)
        {
            _restoreTriggerOnRender = false;
            await _trigger.FocusAsync();
        }
    }

    private void Toggle()
    {
        _open = !_open;
        _error = null;
        _focusPanelOnRender = _open;
        _restoreTriggerOnRender = !_open;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await Credentials.SetUserKeyAsync(_draftKey, _remember);
            Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await Credentials.ClearUserKeyAsync();
            Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            Toggle();
        }

        return Task.CompletedTask;
    }

    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
