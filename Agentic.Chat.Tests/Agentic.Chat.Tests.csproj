<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (TargetFramework, Nullable, ImplicitUsings, analyzers) live in
       the repo-root Directory.Build.props. Only project-specific content stays here. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Coverage gate (coverlet.msbuild 6.0.4). bare `dotnet test -c Release` collects
    cobertura coverage with a 100% minimum on line, branch, and method coverage,
    and fails the test pass on any regression. Only four documented types are gated;
    everything else (Components, Data, MultiAgent, etc.) is outside scope:
    Program.cs, ChatAgentService.cs, OpenRouterOptions.cs, ChatDisplayMessage.cs.
    coverlet.collector 6.0.4 is kept as the explicit-collection mechanism for
    ad-hoc XPlat runs.
  -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>minimum</ThresholdStat>
    <!-- Only the four documented types are gated by include; everything else is outside scope. -->
    <Include>[Agentic.Chat]Program,[Agentic.Chat]Agentic.Chat.Services.ChatAgentService,[Agentic.Chat]Agentic.Chat.Services.OpenRouterOptions,[Agentic.Chat]Agentic.Chat.Models.ChatDisplayMessage</Include>
    <CoverletOutput>coverage/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!--
    The app targets net10.0 via Microsoft.NET.Sdk.Web and consumes Microsoft.Extensions.*
    from the ASP.NET Core shared framework. Reference the same framework here so the test
    project resolves those assemblies at matching framework-aligned versions instead of
    pinning standalone Microsoft.Extensions.* packages (which would create a cross-major
    version mix on net10.0).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agentic.Chat\Agentic.Chat.csproj" />
  </ItemGroup>

</Project>
