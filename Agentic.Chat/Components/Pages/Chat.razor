@page "/chat"
@inject ChatAgentService ChatAgent
@inject ConversationService Conversations
@inject IJSRuntime JS
@inject ModelCatalogService ModelCatalog
@inject SelectedModelService SelectedModel
@implements IDisposable
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Agentic</PageTitle>
<script type="module" src="@Assets["js/chat.js"]"></script>

<div class="chat-shell @(_sidebarOpen ? "sidebar-open" : null)">
    <div class="sidebar-backdrop" @onclick="CloseSidebarAsync" aria-hidden="@(!_sidebarOpen)"></div>

    <aside class="chat-sidebar"
           @ref="_sidebar"
           aria-label="Conversations"
           aria-modal="@(_sidebarOpen ? "true" : null)"
           role="@(_sidebarOpen ? "dialog" : null)"
           @onkeydown="OnSidebarKeyDown"
           id="chat-sidebar">
        <div class="sidebar-header">
            <h2 class="sidebar-title">Chats</h2>
            <button type="button"
                    class="sidebar-close"
                    @onclick="CloseSidebarAsync"
                    aria-label="Close conversation list">
                ×
            </button>
        </div>

        <button type="button"
                class="sidebar-new"
                disabled="@isBusy"
                @onclick="OnSidebarNewChatAsync">
            New chat
        </button>

        <ul class="sidebar-list" role="list">
            @foreach (var conversation in Conversations.Conversations)
            {
                var isActive = conversation.Id == Conversations.ActiveConversationId;
                <li class="sidebar-item @(isActive ? "is-active" : null)">
                    @if (_renamingId == conversation.Id)
                    {
                        <form class="sidebar-rename-form" @onsubmit="ConfirmRenameAsync" @onsubmit:preventDefault>
                            <input class="sidebar-rename-input"
                                   @bind="_renameText"
                                   @bind:event="oninput"
                                   aria-label="Rename conversation"
                                   maxlength="200" />
                            <button type="submit" class="sidebar-icon-btn" aria-label="Save name">✓</button>
                            <button type="button" class="sidebar-icon-btn" @onclick="CancelRename" aria-label="Cancel rename">×</button>
                        </form>
                    }
                    else if (_deleteConfirmId == conversation.Id)
                    {
                        <div class="sidebar-delete-confirm" role="group" aria-label="Confirm delete">
                            <span class="sidebar-delete-label">Delete?</span>
                            <button type="button" class="sidebar-icon-btn danger" disabled="@isBusy" @onclick="() => ConfirmDeleteAsync(conversation.Id)">Yes</button>
                            <button type="button" class="sidebar-icon-btn" disabled="@isBusy" @onclick="CancelDelete">No</button>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="sidebar-item-main"
                                disabled="@isBusy"
                                @onclick="() => SwitchConversationAsync(conversation.Id)">
                            <span class="sidebar-item-title">@conversation.Title</span>
                        </button>
                        <div class="sidebar-item-actions">
                            <button type="button"
                                    class="sidebar-icon-btn"
                                    disabled="@isBusy"
                                    aria-label="Rename conversation"
                                    @onclick="() => BeginRename(conversation)">
                                ✎
                            </button>
                            <button type="button"
                                    class="sidebar-icon-btn danger"
                                    disabled="@isBusy"
                                    aria-label="Delete conversation"
                                    @onclick="() => BeginDelete(conversation.Id)">
                                ⌫
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    </aside>

    <main class="chat-page" @ref="_mainContent">
        <div class="chat-atmosphere" aria-hidden="true">
            <div class="orb orb-a"></div>
            <div class="orb orb-b"></div>
            <div class="orb orb-c"></div>
            <div class="grid-wash"></div>
        </div>

        <header class="chat-brand">
            <button type="button"
                    @ref="_sidebarToggle"
                    class="sidebar-toggle"
                    @onclick="ToggleSidebarAsync"
                    aria-expanded="@_sidebarOpen"
                    aria-controls="chat-sidebar"
                    aria-label="Open conversation list">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>
            <div class="brand-mark" aria-hidden="true">
                <span class="ring ring-1"></span>
                <span class="ring ring-2"></span>
                <span class="core"></span>
            </div>
            <div class="brand-copy">
                <h1 class="brand-name">Agentic</h1>
                <div class="chat-subtitle">
                    <span class="provider-label">Multi-turn via OpenRouter</span>
                    <ModelPicker />
                    <ReasoningEffortControl />
                    @if (_contextMeterText is not null)
                    {
                        <span class="context-meter" title="@_contextMeterTitle">@_contextMeterText</span>
                    }
                </div>
            </div>
            <div class="chat-header-actions">
                <button type="button"
                        class="theme-toggle"
                        aria-label="Theme: Auto. Activate to change."
                        onclick="window.agenticTheme.cycle(this)">
                    Theme: Auto
                </button>
                @if (!string.IsNullOrEmpty(_sessionUsage))
                {
                    <div class="conversation-usage" aria-label="Conversation cost">@_sessionUsage</div>
                }
                @* Hosts host-specific header controls. The WebAssembly client
                   fills this with its OpenRouter credential switcher; the
                   server app renders nothing here. *@
                <SectionOutlet SectionName="chat-header-actions" />
                <SystemPromptSettings />
                <button type="button"
                        class="new-chat-btn"
                        disabled="@isBusy"
                        @onclick="OnSidebarNewChatAsync"
                        aria-label="New chat">
                    New chat
                </button>
                <div class="live-badge @(isBusy ? "is-live" : "")" aria-hidden="true">
                    <span class="live-dot"></span>
                    <span class="live-label">@(isBusy ? "Streaming" : "Ready")</span>
                </div>
            </div>
        </header>

        <div id="chat-status" class="visually-hidden" aria-live="polite" aria-atomic="true">
            @statusText
        </div>

        <div class="chat-stage">
            <div class="chat-messages"
                 @ref="_messagesContainer"
                 role="log"
                 aria-relevant="additions"
                 aria-busy="@isBusy">
                @if (!ChatAgent.Messages.Any())
                {
                    <div class="empty-state">
                        <div class="empty-glyph" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 40c0-11 9-20 20-20s20 9 20 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                                <circle cx="22" cy="28" r="2.5" fill="currentColor"/>
                                <circle cx="42" cy="28" r="2.5" fill="currentColor"/>
                                <path d="M24 46h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                                <path class="spark" d="M48 14l2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5z" fill="currentColor"/>
                            </svg>
                        </div>
                        <p class="empty-title">Start a signal</p>
                        <p class="empty-body">Ask anything. Reasoning streams into Thinking as the model works.</p>
                    </div>
                }

                @for (var i = 0; i < ChatAgent.Messages.Count; i++)
                {
                    @if (_excludedApiMessages > 0 && i == _excludedApiMessages)
                    {
                        <div class="context-trim-divider" role="status">
                            Older messages are not sent to the model
                        </div>
                    }

                    var message = ChatAgent.Messages[i];
                    var isUser = message.Role == "user";
                    var isLast = i == ChatAgent.Messages.Count - 1;
                    <article class="chat-bubble @(isUser ? "user" : "assistant") @(message.IsStreaming ? "is-streaming" : "") @(message.IsError ? "is-error" : "")"
                             aria-label="@(isUser ? "You" : "Assistant")">
                        <div class="bubble-meta">
                            <span class="avatar @(isUser ? "avatar-you" : "avatar-agent")" aria-hidden="true">
                                @(isUser ? "Y" : "A")
                            </span>
                            <div class="chat-role">@(isUser ? "You" : "Assistant")</div>
                            @if (!message.IsStreaming)
                            {
                                <button type="button"
                                        class="message-copy-btn @(_copiedMessage == message ? "is-copied" : "")"
                                        aria-label="@(_copiedMessage == message ? "Message copied" : "Copy message")"
                                        title="Copy message"
                                        @onclick="() => CopyMessageAsync(message)">
                                    <span aria-hidden="true">@(_copiedMessage == message ? "✓" : "⧉")</span>
                                    <span class="message-copy-label">@(_copiedMessage == message ? "Copied" : "Copy")</span>
                                </button>
                            }
                        </div>

                        @if (!isUser && (!string.IsNullOrEmpty(message.Reasoning) || message.IsThinkingOpen))
                        {
                            var thinkingOpen = message.IsThinkingOpen;
                            var thinkingActive = message.IsThinking;
                            <details class="thinking-panel @(thinkingActive ? "is-active" : "")"
                                     open="@thinkingOpen">
                                <summary @onclick="() => ToggleThinking(message)"
                                         @onclick:preventDefault>
                                    @if (thinkingActive)
                                    {
                                        <span class="think-pulse" aria-hidden="true">
                                            <span></span><span></span><span></span>
                                        </span>
                                    }
                                    <span class="think-label">
                                        @(thinkingActive ? "Thinking…" : "Thinking")
                                    </span>
                                    @if (ThoughtDurationLabel(message) is { } duration)
                                    {
                                        <span class="think-duration">@duration</span>
                                    }
                                </summary>
                                <pre class="thinking-text">@(string.IsNullOrEmpty(message.Reasoning) ? "…" : message.Reasoning)</pre>
                            </details>
                        }

                        @if (!string.IsNullOrEmpty(message.Content) || (message.IsStreaming && !string.IsNullOrEmpty(message.Reasoning)))
                        {
                            <div class="chat-content @(isUser ? "is-plain" : "is-markdown")">
                                @if (string.IsNullOrEmpty(message.Content) && message.IsStreaming)
                                {
                                    <span class="chat-pending">
                                        <span class="typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                                        Responding…
                                    </span>
                                }
                                else if (isUser)
                                {
                                    @if (!string.IsNullOrEmpty(message.ImageDataUrl))
                                    {
                                        <img class="user-image-thumb" src="@message.ImageDataUrl" alt="Attached image" />
                                    }
                                    @message.Content
                                }
                                else
                                {
                                    <div class="markdown-body" data-copyable="@(message.IsStreaming ? "false" : "true")">
                                        @((MarkupString)MarkdownRenderer.Render(message.Content))
                                    </div>
                                    @if (message.IsStreaming)
                                    {
                                        <span class="caret" aria-hidden="true"></span>
                                    }
                                }
                            </div>
                        }

                        @if (message.IsError && !isBusy)
                        {
                            <button type="button"
                                    class="msg-action-btn"
                                    disabled="@isBusy"
                                    aria-label="Retry last message"
                                    @onclick="RetryAsync">
                                Retry
                            </button>
                        }

                        @if (isLast && !isUser && !message.IsStreaming && !message.IsError && !isBusy)
                        {
                            <button type="button"
                                    class="msg-action-btn"
                                    disabled="@isBusy"
                                    aria-label="Regenerate response"
                                    @onclick="RegenerateAsync">
                                Regenerate
                            </button>
                        }

                        @if (!isUser && !message.IsStreaming && !message.IsError && message.Usage is not null)
                        {
                            <div class="msg-usage" aria-label="Token usage">
                                @UsageFormatter.FormatMessageFooter(message.Usage)
                            </div>
                        }
                    </article>
                }
                <div class="chat-scroll-sentinel" @ref="_scrollSentinel" aria-hidden="true"></div>
            </div>
        </div>

        <button type="button"
                class="jump-to-latest"
                @ref="_jumpToLatestButton"
                aria-label="Jump to latest message">
            <span aria-hidden="true">↓</span>
            Jump to latest
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div id="chat-error" class="chat-error" role="alert">@errorMessage</div>
        }

        <form class="chat-form" @onsubmit="SendAsync" @onsubmit:preventDefault>
            @if (_queuedText is not null)
            {
                <div class="queued-chip" role="status">
                    <span class="queued-label">Queued</span>
                    <span class="queued-preview">@QueuedPreview(_queuedText)</span>
                    <button type="button"
                            class="queued-cancel"
                            aria-label="Cancel queued message"
                            @onclick="CancelQueued">
                        ×
                    </button>
                </div>
            }
            <div class="composer">
                @if (_modelSupportsImage)
                {
                    <label class="composer-attach" aria-label="Attach image">
                        📷
                        <InputFile @key="_inputFileKey"
                                   id="chat-image-input"
                                   class="visually-hidden"
                                   accept="image/*"
                                   disabled="@isBusy"
                                   OnChange="OnImageSelectedAsync" />
                    </label>
                }
                @if (_stagedImageDataUrl is not null)
                {
                    <div class="composer-image-chip" role="status">
                        <img src="@_stagedImageDataUrl" alt="Selected image preview" />
                        <button type="button"
                                class="composer-image-remove"
                                aria-label="Remove attached image"
                                @onclick="ClearStagedImage">
                            ×
                        </button>
                    </div>
                }
                @if (_imageCapabilityWarning is not null)
                {
                    <div class="composer-image-warning" role="status">@_imageCapabilityWarning</div>
                }
                <label class="visually-hidden" for="chat-input">Message</label>
                <textarea id="chat-input"
                          @ref="_composerInput"
                          @bind="inputText"
                          @bind:event="oninput"
                          class="chat-input"
                          rows="1"
                          placeholder="Type a message…"
                          aria-describedby="@(string.IsNullOrEmpty(errorMessage) ? null : "chat-error")"></textarea>
                @if (isBusy)
                {
                    <button type="button"
                            class="chat-send chat-stop"
                            aria-label="Stop response"
                            @onclick="Cancel">
                        <svg class="send-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="6" y="6" width="12" height="12" rx="1.5" fill="currentColor"/>
                        </svg>
                        <span class="send-text">Stop</span>
                    </button>
                }
                else
                {
                    <button type="submit" class="chat-send" aria-label="Send message">
                        <svg class="send-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h12M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="send-text">Send</span>
                    </button>
                }
            </div>
        </form>
    </main>
</div>

@code {
    private string inputText = string.Empty;
    private bool isBusy;
    private string? errorMessage;
    private string statusText = string.Empty;
    private string? _queuedText;
    private ElementReference _composerInput;
    private ElementReference _messagesContainer;
    private ElementReference _scrollSentinel;
    private ElementReference _jumpToLatestButton;
    private ElementReference _sidebar;
    private ElementReference _sidebarToggle;
    private ElementReference _mainContent;
    private IJSObjectReference? _scrollModule;
    private IJSObjectReference? _scrollController;
    private bool _sidebarOpen;
    private bool _initialized;
    private bool _disposed;
    private Guid? _renamingId;
    private string _renameText = string.Empty;
    private Guid? _deleteConfirmId;
    private CancellationTokenSource? _sendCts;
    private string? _contextMeterText;
    private string? _contextMeterTitle;
    private int _excludedApiMessages;
    private IJSObjectReference? _chatModule;
    private ChatDisplayMessage? _copiedMessage;
    private bool _modelSupportsImage;
    private string? _stagedImageDataUrl;
    private string? _imageCapabilityWarning;
    private string? _queuedImageDataUrl;
    private int _inputFileKey;
    private string _sessionUsage = string.Empty;
    private IJSObjectReference? _drawerController;
    private DotNetObjectReference<Chat>? _selfReference;
    private bool _needsDrawerInitialize;

    protected override void OnInitialized()
    {
        SelectedModel.OnChange += OnSelectedModelChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _scrollModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/chat.js");
                _scrollController = await _scrollModule.InvokeAsync<IJSObjectReference>(
                    "initialize", _messagesContainer, _scrollSentinel, _jumpToLatestButton);
                _selfReference = DotNetObjectReference.Create(this);
            }
            catch
            {
                // Scrolling remains manual if JS isolation is unavailable.
            }
        }

        if (_sidebarOpen && _needsDrawerInitialize && _scrollModule is not null && _selfReference is not null)
        {
            _needsDrawerInitialize = false;
            try
            {
                _drawerController = await _scrollModule.InvokeAsync<IJSObjectReference>(
                    "openDrawer",
                    _sidebar,
                    _mainContent,
                    _sidebarToggle,
                    _selfReference);
            }
            catch
            {
                // The drawer remains usable without focus containment.
            }
        }

        if (!_initialized)
        {
            _initialized = true;
            Conversations.OnChange += OnConversationsChanged;
            await SelectedModel.LoadAsync();
            await UpdateModelCapabilitiesAsync();
            await Conversations.InitializeAsync();
            await RefreshContextMeterAsync();
            RefreshSessionUsage();
            await InvokeAsync(StateHasChanged);
        }

        if (_scrollController is not null)
        {
            try { await _scrollController.InvokeVoidAsync("update", isBusy); }
            catch { /* circuit may be disconnecting */ }
        }

        await EnhanceCodeBlocksAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _queuedText = null;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = null;
        Conversations.OnChange -= OnConversationsChanged;
        SelectedModel.OnChange -= OnSelectedModelChanged;
    }

    private void OnConversationsChanged()
        => _ = InvokeAsync(async () =>
        {
            await RefreshContextMeterAsync();
            RefreshSessionUsage();
            StateHasChanged();
        });

    private void OnSelectedModelChanged()
        => _ = InvokeAsync(async () =>
        {
            try
            {
                await UpdateModelCapabilitiesAsync();
                await RefreshContextMeterAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        });

    private async Task UpdateModelCapabilitiesAsync()
    {
        var modelId = SelectedModel.CurrentModelId;
        if (string.IsNullOrEmpty(modelId))
        {
            _modelSupportsImage = false;
            _imageCapabilityWarning = _stagedImageDataUrl is not null
                ? "This model does not support images. Remove the attachment to send."
                : null;
            return;
        }

        var model = await ModelCatalog.FindByIdAsync(modelId);
        if (!string.Equals(SelectedModel.CurrentModelId, modelId, StringComparison.Ordinal))
        {
            return;
        }

        _modelSupportsImage = model?.SupportsImageInput == true;
        _imageCapabilityWarning = !_modelSupportsImage && _stagedImageDataUrl is not null
            ? "This model does not support images. Remove the attachment or choose a vision model."
            : null;
    }

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > 10 * 1024 * 1024)
        {
            errorMessage = "Image is too large (max 10 MB). Choose a smaller photo.";
            return;
        }

        try
        {
            var resized = await file.RequestImageFileAsync("image/jpeg", maxWidth: 1536, maxHeight: 1536);
            await using var stream = resized.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            _stagedImageDataUrl = $"data:image/jpeg;base64,{base64}";
            if (!_modelSupportsImage)
            {
                _imageCapabilityWarning =
                    "This model does not support images. Remove the attachment or choose a vision model.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not read image: {ex.Message}";
        }
    }

    private void ClearStagedImage()
    {
        _stagedImageDataUrl = null;
        _imageCapabilityWarning = null;
        _inputFileKey++;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await CloseDrawerControllerAsync(restoreFocus: false);
        _selfReference?.Dispose();

        if (_scrollController is not null)
        {
            try { await _scrollController.InvokeVoidAsync("dispose"); }
            catch { /* browser context may already be gone */ }
            try { await _scrollController.DisposeAsync(); }
            catch { /* browser context may already be gone */ }
        }

        if (_scrollModule is not null)
        {
            try { await _scrollModule.DisposeAsync(); }
            catch { /* browser context may already be gone */ }
        }

        if (_chatModule is not null)
        {
            try { await _chatModule.DisposeAsync(); }
            catch { /* module may already be disconnected */ }
        }
    }

    private void RefreshSessionUsage()
        => _sessionUsage = UsageFormatter.FormatConversationTotal(ChatAgent.Messages);

    private static void ToggleThinking(ChatDisplayMessage message)
        => message.SetThinkingOpenByUser(!message.IsThinkingOpen);

    private static string? ThoughtDurationLabel(ChatDisplayMessage message)
        => !message.IsStreaming && message.ThoughtDurationSeconds is { } seconds
            ? $"Thought for {seconds}s"
            : null;

    private async Task CopyMessageAsync(ChatDisplayMessage message)
    {
        var module = await GetChatModuleAsync();
        if (module is null ||
            !await module.InvokeAsync<bool>("writeText", message.Content))
        {
            return;
        }

        _copiedMessage = message;
        statusText = "Copied";
        await InvokeAsync(StateHasChanged);
        await ResetCopyIndicatorAsync(message);
    }

    private async Task ResetCopyIndicatorAsync(ChatDisplayMessage message)
    {
        await Task.Delay(TimeSpan.FromMilliseconds(1500));
        if (_disposed || _copiedMessage != message)
        {
            return;
        }

        _copiedMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnhanceCodeBlocksAsync()
    {
        var module = await GetChatModuleAsync();
        if (module is not null)
        {
            await module.InvokeVoidAsync("addCodeCopyButtons");
        }
    }

    private async Task<IJSObjectReference?> GetChatModuleAsync()
    {
        if (_chatModule is not null)
        {
            return _chatModule;
        }

        try
        {
            _chatModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/chat.js");
        }
        catch
        {
            // Clipboard controls are progressive enhancement.
        }

        return _chatModule;
    }

    private async Task ToggleSidebarAsync()
    {
        if (_sidebarOpen)
        {
            await CloseSidebarAsync();
            return;
        }

        _sidebarOpen = true;
        _needsDrawerInitialize = true;
    }

    private async Task CloseSidebarAsync()
    {
        await CloseDrawerControllerAsync(restoreFocus: true);
        _sidebarOpen = false;
        _needsDrawerInitialize = false;
    }

    [JSInvokable]
    public async Task CloseDrawer()
    {
        await CloseSidebarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSidebarKeyDown(KeyboardEventArgs e)
        => e.Key == "Escape" ? CloseSidebarAsync() : Task.CompletedTask;

    private async Task CloseDrawerControllerAsync(bool restoreFocus)
    {
        if (_drawerController is null)
        {
            return;
        }

        var controller = _drawerController;
        _drawerController = null;
        try { await controller.InvokeVoidAsync("dispose", restoreFocus); }
        catch { /* browser context may already be gone */ }
        try { await controller.DisposeAsync(); }
        catch { /* browser context may already be gone */ }
    }

    private async Task OnSidebarNewChatAsync()
    {
        if (isBusy)
        {
            return;
        }

        await CloseSidebarAsync();
        await Conversations.NewChatAsync();
        ResetComposerChrome(clearStatus: true);
        await RefreshContextMeterAsync();
        await FocusComposerAsync();
    }

    private async Task SwitchConversationAsync(Guid id)
    {
        if (isBusy)
        {
            return;
        }

        await CloseSidebarAsync();
        await Conversations.SwitchAsync(id);
        ResetComposerChrome();
        await RefreshContextMeterAsync();
        await FocusComposerAsync();
    }

    private void ResetComposerChrome(bool clearStatus = false)
    {
        _sidebarOpen = false;
        _renamingId = null;
        _deleteConfirmId = null;
        _queuedText = null;
        errorMessage = null;
        if (clearStatus)
        {
            statusText = string.Empty;
        }
    }

    private void BeginRename(ConversationListItem conversation)
    {
        _renamingId = conversation.Id;
        _renameText = conversation.Title;
        _deleteConfirmId = null;
    }

    private void CancelRename()
    {
        _renamingId = null;
        _renameText = string.Empty;
    }

    private async Task ConfirmRenameAsync()
    {
        if (_renamingId is not Guid id || string.IsNullOrWhiteSpace(_renameText))
        {
            CancelRename();
            return;
        }

        await Conversations.RenameAsync(id, _renameText);
        CancelRename();
    }

    private void BeginDelete(Guid id)
    {
        _deleteConfirmId = id;
        _renamingId = null;
    }

    private void CancelDelete() => _deleteConfirmId = null;

    private async Task ConfirmDeleteAsync(Guid id)
    {
        if (isBusy)
        {
            return;
        }

        await Conversations.DeleteAsync(id);
        _deleteConfirmId = null;
    }

    private async Task FocusComposerAsync()
    {
        try
        {
            await _composerInput.FocusAsync();
        }
        catch
        {
            /* focus failure is non-fatal */
        }
    }

    private void Cancel()
    {
        _sendCts?.Cancel();
    }

    private CancellationToken BeginSend()
    {
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();
        return _sendCts.Token;
    }

    private void EndSend()
    {
        isBusy = false;
        _sendCts?.Dispose();
        _sendCts = null;
    }

    private static string QueuedPreview(string text)
        => ChatAgentService.Truncate(text.Trim(), 48);

    private void CancelQueued()
    {
        _queuedText = null;
        _queuedImageDataUrl = null;
        statusText = isBusy ? "Assistant is responding" : string.Empty;
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(inputText) && _stagedImageDataUrl is null)
        {
            return;
        }

        if (_stagedImageDataUrl is not null && !_modelSupportsImage)
        {
            errorMessage = "This model does not support images. Remove the attachment or choose a vision model.";
            return;
        }

        var text = string.IsNullOrWhiteSpace(inputText) ? "What's in this image?" : inputText.Trim();
        var image = _stagedImageDataUrl;
        inputText = string.Empty;

        if (isBusy)
        {
            _queuedText = text;
            _queuedImageDataUrl = image;
            statusText = "Message queued";
            await FocusComposerAsync();
            return;
        }

        _stagedImageDataUrl = null;
        _imageCapabilityWarning = null;
        await SendCoreAsync(text, image);
    }

    private async Task SendCoreAsync(string text, string? imageDataUrl = null)
    {
        // Claim busy before any await so a concurrent Enter cannot start a
        // second stream (and cancel this one via BeginSend) during follow().
        isBusy = true;
        statusText = "Assistant is responding";

        if (_scrollController is not null)
        {
            try { await _scrollController.InvokeVoidAsync("follow"); }
            catch { /* circuit may be disconnecting */ }
        }

        await RunStreamAsync(
            "Assistant is responding",
            ct => ChatAgent.SendStreamingAsync(text, imageDataUrl, ct));
    }

    /// <summary>
    /// End the current send without opening a race window: if a message is queued
    /// and the circuit is still alive, hand off while <c>isBusy</c> stays true.
    /// Otherwise clear busy and restore focus. Never drain after dispose.
    /// </summary>
    private async Task FinishSendAsync()
    {
        if (_disposed)
        {
            _queuedText = null;
            _queuedImageDataUrl = null;
            EndSend();
            return;
        }

        if (_queuedText is { } queued)
        {
            var queuedImage = _queuedImageDataUrl;
            _queuedText = null;
            _queuedImageDataUrl = null;
            // Keep isBusy true across the handoff so a concurrent Enter cannot
            // start a second stream while we await the nested send.
            await SendCoreAsync(queued, queuedImage);
            return;
        }

        EndSend();
        await FocusComposerAsync();
    }

    private async Task RetryAsync()
    {
        if (isBusy)
        {
            return;
        }

        await RunStreamAsync("Retrying", ct => ChatAgent.RetryLastAsync(ct));
    }

    private async Task RegenerateAsync()
    {
        if (isBusy)
        {
            return;
        }

        await RunStreamAsync("Regenerating", ct => ChatAgent.RegenerateAsync(ct));
    }

    private async Task RunStreamAsync(
        string busyStatus,
        Func<CancellationToken, IAsyncEnumerable<ChatDisplayMessage>> streamFactory)
    {
        errorMessage = null;
        isBusy = true;
        statusText = busyStatus;
        var ct = BeginSend();
        await FocusComposerAsync();

        try
        {
            await foreach (var _ in streamFactory(ct))
            {
                await RefreshContextMeterAsync();
                await InvokeAsync(StateHasChanged);
            }

            await Conversations.RefreshAfterTurnAsync();
            RefreshSessionUsage();
            statusText = "Response complete";
        }
        catch (OperationCanceledException ex) when (ex.CancellationToken == ct)
        {
            statusText = "Response stopped";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            statusText = string.Empty;
            try { await Conversations.RefreshAfterTurnAsync(); } catch { }
        }
        finally
        {
            await FinishSendAsync();
        }
    }

    private async Task RefreshContextMeterAsync()
    {
        try
        {
            var model = await ModelCatalog.FindByIdAsync(ChatAgent.CurrentModelId);
            if (model?.ContextLength is not > 0)
            {
                _contextMeterText = null;
                _contextMeterTitle = null;
                _excludedApiMessages = 0;
                return;
            }

            var context = ChatAgent.GetContextWindow(model.ContextLength);
            _contextMeterText = $"~{FormatTokens(context.TranscriptTokens)} / {FormatTokens(model.ContextLength)}";
            _contextMeterTitle = "Estimated transcript tokens / model context limit";
            _excludedApiMessages = context.ExcludedMessageCount;
        }
        catch
        {
            // The meter is advisory; a transient catalog failure must not affect chat.
            _contextMeterText = null;
            _contextMeterTitle = null;
            _excludedApiMessages = 0;
        }
    }

    private static string FormatTokens(long tokens)
    {
        if (tokens < 1_000)
        {
            return tokens.ToString();
        }

        return tokens % 1_000 == 0
            ? $"{tokens / 1_000}k"
            : $"{tokens / 1_000m:0.#}k";
    }
}
