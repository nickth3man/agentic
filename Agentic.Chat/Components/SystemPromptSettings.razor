@* SystemPromptSettings.razor — gear-icon settings popover for system prompt + generation params.

   Presets fill the textarea; the textarea stays editable. Persistence mirrors
   SelectedModelService via SystemPromptService / ChatSettingsService + ProtectedLocalStorage.
   The "Default" preset clears the UI override so OpenRouter:SystemPrompt wins.
   Changes apply to the next conversation (Reset/New chat); when the transcript
   is empty, RefreshSystemMessageIfIdle updates the in-memory system entry now. *@

@inject SystemPromptService SystemPrompt
@inject ChatSettingsService ChatSettings
@inject ChatAgentService ChatAgent
@inject IOptions<OpenRouterOptions> Options
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="system-prompt-settings">
    <button type="button"
            @ref="_trigger"
            class="settings-gear @(IsOpen ? "is-open" : "")"
            aria-haspopup="dialog"
            aria-expanded="@IsOpen"
            aria-label="Chat settings"
            @onclick="ToggleAsync">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"
                  stroke="currentColor" stroke-width="1.75"/>
            <path d="M19.4 13.5a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V19.5a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H4.5a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.01a1.7 1.7 0 0 0 1-1.55V4.5a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.01a1.7 1.7 0 0 0 1.55 1h.09a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z"
                  stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
        </svg>
    </button>

    @if (IsOpen)
    {
        <dialog class="settings-popover"
                @ref="_dialog"
                open
                aria-label="Chat settings"
                aria-modal="true"
                tabindex="-1">
            <div class="settings-popover-header">
                <h2 class="settings-title">System prompt</h2>
                <p class="settings-hint">Applies to the next conversation (New chat). Default uses appsettings.</p>
            </div>

            <label class="settings-label" for="system-prompt-preset">Preset</label>
            <select id="system-prompt-preset"
                    class="settings-preset"
                    @bind="_selectedPreset"
                    @bind:after="OnPresetChanged">
                <option value="">Custom…</option>
                @foreach (var preset in SystemPromptService.Presets)
                {
                    <option value="@preset.Name">@preset.Name</option>
                }
            </select>

            <label class="settings-label" for="system-prompt-text">Prompt</label>
            <textarea id="system-prompt-text"
                      class="settings-textarea"
                      rows="6"
                      maxlength="@SystemPromptService.MaxPromptLength"
                      spellcheck="true"
                      @bind="_draft"
                      @bind:event="oninput"
                      @bind:after="OnDraftChanged"></textarea>

            <div class="settings-divider" role="separator"></div>

            <div class="settings-popover-header">
                <h2 class="settings-title settings-title-sm">Generation</h2>
                <p class="settings-hint">Optional; blank uses the provider default. Sent only when the model supports the parameter.</p>
            </div>

            <label class="settings-label" for="settings-temperature">
                Temperature
                <span class="settings-value">@(_tempEnabled ? _tempDraft.ToString("0.00") : "default")</span>
            </label>
            <div class="settings-slider-row">
                <input id="settings-temperature"
                       type="range"
                       class="settings-range"
                       min="@ChatSettingsService.MinTemperature"
                       max="@ChatSettingsService.MaxTemperature"
                       step="0.05"
                       disabled="@(!_tempEnabled)"
                       @bind="_tempDraft"
                       @bind:event="oninput" />
                <label class="settings-check">
                    <input type="checkbox" @bind="_tempEnabled" @bind:after="OnTempEnabledChanged" />
                    Set
                </label>
            </div>

            <label class="settings-label" for="settings-max-tokens">
                Max tokens
                <span class="settings-value">@(_maxEnabled ? _maxDraft.ToString() : "default")</span>
            </label>
            <div class="settings-slider-row">
                <input id="settings-max-tokens"
                       type="range"
                       class="settings-range"
                       min="@ChatSettingsService.MinMaxTokens"
                       max="8192"
                       step="64"
                       disabled="@(!_maxEnabled)"
                       @bind="_maxDraft"
                       @bind:event="oninput" />
                <label class="settings-check">
                    <input type="checkbox" @bind="_maxEnabled" @bind:after="OnMaxEnabledChanged" />
                    Set
                </label>
            </div>

            <div class="settings-actions">
                @if (_error is not null)
                {
                    <p class="settings-error" role="alert">@_error</p>
                }
                <button type="button"
                        class="settings-apply"
                        disabled="@(_isSaving || string.IsNullOrWhiteSpace(_draft))"
                        @onclick="ApplyAsync">
                    @(_isSaving ? "Saving…" : "Apply")
                </button>
                <button type="button"
                        class="settings-cancel"
                        disabled="@_isSaving"
                        @onclick="CloseAsync">
                    Close
                </button>
            </div>
        </dialog>
    }
</div>

@code {
    private bool IsOpen { get; set; }
    private string _draft = string.Empty;
    private string _selectedPreset = string.Empty;
    private bool _isSaving;
    private bool _loaded;
    private string? _error;

    private bool _tempEnabled;
    private double _tempDraft = 1.0;
    private bool _maxEnabled;
    private int _maxDraft = 2048;
    private ElementReference _trigger;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _modalCleanupFn;
    private DotNetObjectReference<SystemPromptSettings>? _dotnetRef;
    private bool _needsModalInitialize;

    protected override void OnInitialized()
    {
        SystemPrompt.OnChange += HandlePromptChanged;
        ChatSettings.OnChange += HandleSettingsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SystemPrompt.LoadAsync();
            await ChatSettings.LoadAsync();
        }
        catch
        {
            /* persistence is non-fatal */
        }

        SyncDraftFromService();
        SyncGenerationFromService();
        ChatAgent.RefreshSystemMessageIfIdle();
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureModuleAsync();
        }

        if (IsOpen && _module is null)
        {
            await EnsureModuleAsync();
        }

        if (IsOpen && _needsModalInitialize && _module is not null && _dotnetRef is not null)
        {
            _needsModalInitialize = false;
            try
            {
                _modalCleanupFn = await _module.InvokeAsync<IJSObjectReference>(
                    "openModal",
                    _dialog,
                    _trigger,
                    _dotnetRef,
                    "CloseModal",
                    ".settings-preset");
            }
            catch
            {
                // The dialog remains rendered if top-layer setup fails.
            }
        }
    }

    private void HandlePromptChanged()
    {
        if (!_loaded || IsOpen)
        {
            return;
        }

        SyncDraftFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleSettingsChanged()
    {
        if (!_loaded || IsOpen)
        {
            return;
        }

        SyncGenerationFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncDraftFromService()
    {
        if (string.IsNullOrWhiteSpace(SystemPrompt.CurrentPrompt))
        {
            _draft = EffectiveConfigPrompt();
            _selectedPreset = "Default";
            return;
        }

        _draft = SystemPrompt.CurrentPrompt!;
        _selectedPreset = MatchPresetName(_draft) ?? string.Empty;
    }

    private void SyncGenerationFromService()
    {
        _tempEnabled = ChatSettings.Temperature is not null;
        _tempDraft = ChatSettings.Temperature ?? 1.0;
        _maxEnabled = ChatSettings.MaxTokens is not null;
        _maxDraft = ChatSettings.MaxTokens ?? 2048;
    }

    private string EffectiveConfigPrompt()
        => !string.IsNullOrWhiteSpace(Options.Value.SystemPrompt)
            ? Options.Value.SystemPrompt.Trim()
            : OpenRouterOptions.DefaultSystemPrompt;

    private static string? MatchPresetName(string prompt)
    {
        foreach (var preset in SystemPromptService.Presets)
        {
            if (preset.Prompt is null)
            {
                continue;
            }

            if (string.Equals(preset.Prompt, prompt, StringComparison.Ordinal))
            {
                return preset.Name;
            }
        }

        return null;
    }

    private async Task ToggleAsync()
    {
        if (IsOpen)
        {
            await CloseAsync();
        }
        else
        {
            await EnsureModuleAsync();
            SyncDraftFromService();
            SyncGenerationFromService();
            IsOpen = true;
            _needsModalInitialize = true;
        }
    }

    private async Task CloseAsync()
    {
        await CloseModalAsync();
        IsOpen = false;
        _needsModalInitialize = false;
    }

    private void OnPresetChanged()
    {
        if (string.IsNullOrEmpty(_selectedPreset))
        {
            return;
        }

        var preset = SystemPromptService.Presets
            .FirstOrDefault(p => p.Name == _selectedPreset);
        if (preset is null)
        {
            return;
        }

        _draft = preset.Prompt is null
            ? EffectiveConfigPrompt()
            : preset.Prompt;
    }

    private void OnDraftChanged()
    {
        if (string.IsNullOrWhiteSpace(SystemPrompt.CurrentPrompt)
            && string.Equals(_draft.Trim(), EffectiveConfigPrompt(), StringComparison.Ordinal))
        {
            _selectedPreset = "Default";
            return;
        }

        _selectedPreset = MatchPresetName(_draft) ?? string.Empty;
    }

    private void OnTempEnabledChanged()
    {
        if (!_tempEnabled)
        {
            _tempDraft = 1.0;
        }
    }

    private void OnMaxEnabledChanged()
    {
        if (!_maxEnabled)
        {
            _maxDraft = 2048;
        }
    }

    private async Task ApplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _error = null;
        try
        {
            var preset = SystemPromptService.Presets
                .FirstOrDefault(p => p.Name == _selectedPreset);
            if (preset is not null && preset.Prompt is null)
            {
                await SystemPrompt.ClearAsync();
            }
            else
            {
                await SystemPrompt.SetAsync(_draft.Trim());
            }

            await ChatSettings.SetTemperatureAsync(_tempEnabled ? _tempDraft : null);
            await ChatSettings.SetMaxTokensAsync(_maxEnabled ? _maxDraft : null);

            ChatAgent.RefreshSystemMessageIfIdle();
            await CloseAsync();
        }
        catch (Exception exception)
        {
            _error = $"Settings could not be saved: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    [JSInvokable]
    public async Task CloseModal()
    {
        await CloseAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureModuleAsync()
    {
        if (_module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/model-picker.js");
            _dotnetRef ??= DotNetObjectReference.Create(this);
        }
        catch
        {
            // The open attribute keeps the form usable if modal enhancement fails.
        }
    }

    private async Task CloseModalAsync()
    {
        if (_modalCleanupFn is null)
        {
            return;
        }

        var cleanup = _modalCleanupFn;
        _modalCleanupFn = null;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("closeModal", cleanup, true); }
            catch { /* browser context may already be gone */ }
        }
        try { await cleanup.DisposeAsync(); }
        catch { /* already disposed */ }
    }

    public async ValueTask DisposeAsync()
    {
        SystemPrompt.OnChange -= HandlePromptChanged;
        ChatSettings.OnChange -= HandleSettingsChanged;
        await CloseModalAsync();
        _dotnetRef?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { /* browser context may already be gone */ }
        }
    }
}
